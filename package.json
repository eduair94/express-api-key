{
  "bin": {
    "api_key_express": "./dist/api_key_express.js"
  },
  "name": "express-api-key",
  "version": "1.7.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "mega": "api_key_express role mega 0.5 500000",
    "test": "tsx src/dashboard/renewLinks.test.ts && tsx src/dashboard/subscriptionPanel.test.ts && tsx src/dashboard/dashboardRenew.test.ts && tsx src/dashboard/dashboardDocsLink.test.ts && tsx src/middleware/dashboardLogin.test.ts",
    "build": "tsc && npm run copy-templates",
    "copy-templates": "node -e \"const fs=require('fs');const path=require('path');const src='src/dashboard/templates';const dest='dist/dashboard/templates';fs.mkdirSync(dest,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dest,f)));\"",
    "start:example": "npx tsx src/example.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "express",
    "api-key",
    "middleware",
    "authentication",
    "rate-limit"
  ],
  "author": "",
  "license": "ISC",
  "description": "Express middleware for API key authentication, role-based access, and rate limiting.",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduair94/express-api-key.git"
  },
  "homepage": "https://github.com/eduair94/express-api-key#readme",
  "bugs": {
    "url": "https://github.com/eduair94/express-api-key/issues"
  },
  "files": [
    "dist",
    "README.md",
    "roles.json"
  ],
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "mongoose": "^9.10.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "mongoose": "^8.16.5 || ^9.0.0"
  }
}
